# Only for previewing locally. GitHub Pages builds with actions/jekyll-build-pages,
# which uses its own github-pages bundle and merely reads this file to warn if it
# cannot satisfy it — so pinning the same gem keeps the two in step.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick" # dropped from Ruby 3's stdlib; `jekyll serve` still needs it
